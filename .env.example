# ─── Obligatorio ────────────────────────────────────────────────────────────

# Token de tu bot de Telegram (crealo con @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=

# Tu chat ID numerico de Telegram (usa @userinfobot para obtenerlo)
TELEGRAM_CHAT_ID=

# ─── Opcional (valores por defecto) ─────────────────────────────────────────

# URL de TestFlight de WhatsApp (se auto-descubre desde WABetaInfo cada 30 min)
TESTFLIGHT_URL=https://testflight.apple.com/join/YcmGWyxV

# URL de WABetaInfo donde buscar el link de TestFlight
WABETAINFO_URL=https://wabetainfo.com/wa-testflight/

# Intervalo minimo entre peticiones a Apple (segundos)
MIN_INTERVAL=2

# Intervalo maximo entre peticiones a Apple (segundos)
MAX_INTERVAL=30

# Cada cuantos segundos refrescar la URL desde WABetaInfo (1800 = 30 min)
URL_REFRESH_INTERVAL=1800

# Errores consecutivos antes de enviar alerta por Telegram
ERROR_THRESHOLD=3

# Segundos entre cada polling de comandos de Telegram
POLL_INTERVAL=5

# Puerto para el health check (Render asigna automaticamente)
PORT=8080
